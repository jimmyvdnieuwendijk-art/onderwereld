# --- Local (SQLite) ---
# Relative to the prisma/ directory. Fine for `npm run dev`, not for Vercel.
DATABASE_URL="file:./dev.db"

# --- Production (Postgres) ---
# SQLite cannot run on Vercel serverless: the filesystem is ephemeral and not
# shared between lambdas, so player data would vanish or corrupt.
# 1. Change prisma/schema.prisma datasource provider to "postgresql"
# 2. Set DATABASE_URL to a hosted Postgres URL (Neon, Supabase, or Vercel Postgres):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/onderwereld?sslmode=require"

# Required. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Required in production so Auth.js trusts the Vercel Host header.
AUTH_TRUST_HOST="true"

# Optional. Prefer omitting AUTH_URL locally so Auth.js trusts the incoming Host
# (localhost vs 127.0.0.1). On Vercel, set it to the public origin once you have it:
# AUTH_URL="https://your-app.vercel.app"

# Optional: skip creating demo users during seed
# SKIP_DEMO_USERS=0

# Optional: allow prisma/seed.ts to wipe the database (never set on a live game)
# FORCE_SEED=0
