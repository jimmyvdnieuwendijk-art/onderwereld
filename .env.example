# SQLite (default, works out of the box)
DATABASE_URL="file:./dev.db"

# PostgreSQL (optional production path)
# 1. Change provider in prisma/schema.prisma to "postgresql"
# 2. Uncomment and fill:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/onderwereld"

AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:43147"

# Optional: set to 1 to skip demo-user creation during seed
# SKIP_DEMO_USERS=0
