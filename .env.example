# PostgreSQL (required for Vercel and the default Prisma provider).
# Replace USER, PASSWORD, and HOST with values from Neon, Supabase, or Vercel Postgres.
# Do not commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/onderwereld?sslmode=require"

# Local-only SQLite alternative (not for Vercel):
# 1. Set provider in prisma/schema.prisma to "sqlite"
# 2. DATABASE_URL="file:./dev.db"

# Required. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Required in production so Auth.js trusts the Vercel Host header.
AUTH_TRUST_HOST="true"

# Optional. Prefer omitting AUTH_URL locally so Auth.js trusts the incoming Host
# (localhost vs 127.0.0.1). On Vercel, set it to the public origin once you have it:
# AUTH_URL="https://your-app.vercel.app"

# Optional: skip creating demo users during seed
# SKIP_DEMO_USERS=0

# Optional: allow prisma/seed.ts to wipe the database (never set on a live game)
# FORCE_SEED=0
