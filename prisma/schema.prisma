generator client {
  provider      = "prisma-client-js"
  // native = local machines; rhel-openssl-3.0.x = Vercel / AWS Lambda (AL2023)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// Production (Vercel): PostgreSQL — Neon, Supabase, or Vercel Postgres.
// SQLite is not suitable on serverless (ephemeral disk, not shared across lambdas).
// Local-only alternative: set provider to "sqlite" and DATABASE_URL="file:./dev.db".
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  hashedPassword        String
  username              String    @unique
  cash                  Int       @default(500)
  bankBalance           Int       @default(0)
  health                Int       @default(100)
  energy                Int       @default(100)
  rankId                String
  rank                  Rank      @relation(fields: [rankId], references: [id])
  exp                   Int       @default(0)
  bullets               Int       @default(0)
  defense               Int       @default(0)
  attackPower           Int       @default(5)
  killCount             Int       @default(0)
  wantedLevel           Int       @default(0)
  inJailUntil           DateTime?
  inHospitalUntil       DateTime?
  isDead                Boolean   @default(false)
  currentCity           String    @default("ams")
  travelEndAt           DateTime?
  travelDestinationId   String?
  drugs                 Int       @default(0)
  weaponCrates          Int       @default(0)
  pimpExp               Int       @default(0)
  mainEscortId          String?
  lastPimpTickAt        DateTime  @default(now())
  lastRaidAt            DateTime?
  familyId              String?
  family                Family?   @relation("FamilyRoster", fields: [familyId], references: [id])
  lastCrimeAt           DateTime?
  crimeCooldownUntil    DateTime?
  carTheftCooldownUntil DateTime?
  lastEnergyAt          DateTime  @default(now())
  lastInterestAt        DateTime  @default(now())
  equippedWeaponId      String?
  equippedArmorId       String?
  equippedWeapon        ShopItem? @relation("EquippedWeapon", fields: [equippedWeaponId], references: [id])
  equippedArmor         ShopItem? @relation("EquippedArmor", fields: [equippedArmorId], references: [id])
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  ledFamily        Family?          @relation("FamilyLeader")
  familyMembership FamilyMember?
  vehicles         Vehicle[]
  inventory        InventoryItem[]
  marketListings   MarketListing[]  @relation("SellerListings")
  sentMessages     Message[]        @relation("SentMessages")
  receivedMessages Message[]        @relation("ReceivedMessages")
  shoutboxMessages ShoutboxMessage[]
  gameLogs         GameLog[]
  attacksMade      AttackLog[]      @relation("Attacker")
  attacksReceived  AttackLog[]      @relation("Defender")
  escorts          Escort[]
  redLightWindows  RedLightWindow[]

  @@index([rankId])
  @@index([familyId])
  @@index([isDead])
  @@index([currentCity])
  @@index([travelEndAt])
  @@index([inJailUntil])
  @@index([inHospitalUntil])
}

model Rank {
  id     String @id @default(cuid())
  slug   String @unique
  name   String
  minExp Int
  order  Int    @unique
  users  User[]
}

model Crime {
  id              String @id @default(cuid())
  slug            String @unique
  name            String
  description     String
  minRankOrder    Int
  successChance   Int
  cashMin         Int
  cashMax         Int
  expReward       Int
  energyCost      Int
  jailRiskChance  Int
  jailMinutes     Int
  cooldownSeconds Int
}

model VehicleType {
  id              String    @id @default(cuid())
  slug            String    @unique
  name            String
  baseValue       Int
  stealDifficulty Int
  rarity          String
  minRankOrder    Int       @default(1)
  vehicles        Vehicle[]
}

model Vehicle {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleTypeId String
  vehicleType   VehicleType  @relation(fields: [vehicleTypeId], references: [id])
  condition     Int          @default(100)
  createdAt     DateTime     @default(now())
  listings      MarketListing[]

  @@index([userId])
}

model ShopItem {
  id               String          @id @default(cuid())
  slug             String          @unique
  name             String
  description      String
  type             String
  attack           Int             @default(0)
  defense          Int             @default(0)
  healAmount       Int             @default(0)
  energyAmount     Int             @default(0)
  bulletsAmount    Int             @default(0)
  price            Int
  minRankOrder     Int             @default(1)
  inventory        InventoryItem[]
  listings         MarketListing[]
  equippedAsWeapon User[]          @relation("EquippedWeapon")
  equippedAsArmor  User[]          @relation("EquippedArmor")
}

model InventoryItem {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId   String
  item     ShopItem @relation(fields: [itemId], references: [id])
  quantity Int      @default(1)

  @@unique([userId, itemId])
  @@index([userId])
}

model Family {
  id          String         @id @default(cuid())
  name        String         @unique
  leaderId    String         @unique
  leader      User           @relation("FamilyLeader", fields: [leaderId], references: [id])
  bankBalance Int            @default(0)
  description String         @default("")
  createdAt   DateTime       @default(now())
  members     User[]         @relation("FamilyRoster")
  memberships FamilyMember[]
}

model FamilyMember {
  id       String   @id @default(cuid())
  familyId String
  family   Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId   String   @unique
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())

  @@index([familyId])
}

model MarketListing {
  id        String    @id @default(cuid())
  sellerId  String
  seller    User      @relation("SellerListings", fields: [sellerId], references: [id], onDelete: Cascade)
  type      String
  quantity  Int       @default(1)
  price     Int
  vehicleId String?
  vehicle   Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  itemId    String?
  item      ShopItem? @relation(fields: [itemId], references: [id])
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@index([active, type])
  @@index([sellerId])
}

model Message {
  id         String   @id @default(cuid())
  fromUserId String
  fromUser   User     @relation("SentMessages", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User     @relation("ReceivedMessages", fields: [toUserId], references: [id], onDelete: Cascade)
  subject    String
  body       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([toUserId, read])
  @@index([fromUserId])
}

model ShoutboxMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model GameLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model AttackLog {
  id          String   @id @default(cuid())
  attackerId  String
  attacker    User     @relation("Attacker", fields: [attackerId], references: [id], onDelete: Cascade)
  defenderId  String
  defender    User     @relation("Defender", fields: [defenderId], references: [id], onDelete: Cascade)
  bulletsUsed Int
  damage      Int
  outcome     String
  createdAt   DateTime @default(now())

  @@index([attackerId, createdAt])
  @@index([defenderId, createdAt])
}

model Escort {
  id          String           @id @default(cuid())
  ownerId     String
  owner       User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  avatar      String
  charm       Int              @default(40)
  loyalty     Int              @default(70)
  health      Int              @default(100)
  cityId      String           @default("ams")
  windowId    String?          @unique
  window      RedLightWindow?  @relation(fields: [windowId], references: [id], onDelete: SetNull)
  listedPrice Int?
  busyUntil   DateTime?
  missionKind String?
  missionKey  String?
  createdAt   DateTime         @default(now())

  @@index([ownerId])
  @@index([cityId])
  @@index([listedPrice])
}

model RedLightWindow {
  id         String   @id @default(cuid())
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cityId     String
  slotIndex  Int
  hiredUntil DateTime
  escort     Escort?
  createdAt  DateTime @default(now())

  @@unique([ownerId, cityId, slotIndex])
  @@index([ownerId, cityId])
}
