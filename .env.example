# PostgreSQL (required — Prisma provider is postgresql).
# Neon project sparkling-mouse-47508820, branch production.
# Paste the Neon *pooled* connection string for Vercel (sslmode=require).
# Do not commit real credentials. `neon env pull` writes .env.local after `neon login`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Local-only SQLite alternative (not for Vercel):
# 1. Set provider in prisma/schema.prisma to "sqlite"
# 2. DATABASE_URL="file:./dev.db"

# Required. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Required in production so Auth.js trusts the Vercel Host header.
AUTH_TRUST_HOST="true"

# Facebook Login (Auth.js / NextAuth Facebook provider).
# Create an app at https://developers.facebook.com/ — Facebook Login product,
# then add these Valid OAuth Redirect URIs:
#   http://localhost:43147/api/auth/callback/facebook
#   https://onderwereld-nine.vercel.app/api/auth/callback/facebook
# If unset, the Facebook button is visible but disabled.
# AUTH_FACEBOOK_ID=""
# AUTH_FACEBOOK_SECRET=""
# Aliases also accepted: AUTH_FACEBOOK_CLIENT_ID / AUTH_FACEBOOK_CLIENT_SECRET

# Optional GA4 measurement ID (G-XXXXXXXX). Leave unset until you have a real property.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Optional. Prefer omitting AUTH_URL locally so Auth.js trusts the incoming Host
# (localhost vs 127.0.0.1). On Vercel, set it to the public origin once you have it:
# AUTH_URL="https://your-app.vercel.app"

# Optional: skip creating demo users during seed
# SKIP_DEMO_USERS=0

# Optional: allow prisma/seed.ts to wipe the database (never set on a live game)
# FORCE_SEED=0
